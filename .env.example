# CRM Backend Configuration
# -------------------------
# Target URL for the Vite development proxy (/api -> CRM_API_URL)
CRM_API_URL=http://localhost:8081

# Optional API base URL for client requests. Leave blank to use relative /api proxied by Vite dev server,
# or set to http://localhost:8081/api to send cross-origin requests directly to the Spring Boot backend.
VITE_API_BASE_URL=

# Default development user identity (u1: Sophie Turner, u2: Alex Stewart, u3: Marcus Vance, u4: Priya Sharma)
VITE_DEV_USER=u1
